          memory: {
            status: 'archived',
            specs: ['portal-architecture', 'auth-model', 'api-envelope'],
            checkpoints: [
              { type: 'context', title: 'Session ownership' },
              { type: 'followup', title: 'Mobile drawer labels' },
              { type: 'note', title: 'API envelope adopted' },
              { type: 'decision', title: 'Move tokens to HttpOnly cookies' },
