---
import { ArrowRight, Zap } from 'lucide-astro';

const lang = Astro.locals.starlightRoute?.entryMeta?.lang ?? 'en';
const isZh = lang.toLowerCase().startsWith('zh');
const base = import.meta.env.BASE_URL;
const quickStartHref = `${base}docs/quick-start/`;

type Checkpoint = { type: string; title: string };
type Memory = {
  status: 'in_progress' | 'archived' | 'distilled';
  specs: string[];
  checkpoints: Checkpoint[];
  distilled?: string;
};
type Step = {
  short: string;
  title: string;
  user?: string;
  userCommand?: string;
  command?: string;
  output?: string;
  agent: string[];
  checkpoint?: { type: string; title: string; message: string };
  memory: Memory;
};

const copy = isZh
  ? {
      kicker: '工作流 / 闭环',
      title: '一个任务，走完整个闭环。',
      lede:
        '安装一次 CLI，然后在 Agent 里完成从开始、读取上下文、记录决策，到归档和沉淀规范的完整流程。下一次会话，记忆已经在这里。',
      installLabel: '01 / 安装一次',
      agentLabel: '02 / 在 Agent 输入框调用',
      installNote: 'Node.js 18+ · 无需账号 · 数据在本地',
      userInput: '用户输入',
      exampleCommand: 'lattice:task:start',
      windowTitle: 'agent · acme-portal',
      windowStatus: '本地 · 模拟',
      memoryTitle: '任务记忆',
      memorySpecs: '引用的规范',
      memoryCheckpoints: '检查点',
      memoryDistilled: '已沉淀',
      memoryEmpty: '尚无检查点',
      pause: '暂停',
      play: '播放',
      replay: '重播',
      prev: '上一步',
      next: '下一步',
      step: '步骤',
      scrollHint: '↕ 滚动加速',
