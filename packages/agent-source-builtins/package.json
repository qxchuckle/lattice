{
  "name": "@qcqx/lattice-agent-source-builtins",
  "version": "0.1.0",
  "description": "Lattice Agent 内置源合集：Pi / Qoder / ACP",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./pi": {
      "import": {
        "types": "./dist/pi/index.d.ts",
        "default": "./dist/pi/index.js"
      }
    },
    "./qoder": {
      "import": {
        "types": "./dist/qoder/index.d.ts",
        "default": "./dist/qoder/index.js"
      }
    },
    "./acp": {
      "import": {
        "types": "./dist/acp/index.d.ts",
        "default": "./dist/acp/index.js"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist dist-types tsconfig.tsbuildinfo"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "@qcqx/lattice-agent-source": "workspace:*",
    "@qcqx/lattice-agent-protocol": "workspace:*"
  },
  "dependencies": {
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}