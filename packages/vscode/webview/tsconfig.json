{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@lattice-web-ui": ["../../web-ui/src/ui.ts"],
      "@qcqx/lattice-protocol": ["../../protocol/src/index.ts"],
      "@qcqx/lattice-services": ["../../services/src/index.ts"],
      "@qcqx/lattice-core": ["../../core/src/index.ts"]
    }
  },
  "include": ["src", "../../web-ui/src/types", "../../../types"]
}
