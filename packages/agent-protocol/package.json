{
  "name": "@qcqx/lattice-agent-protocol",
  "version": "0.1.0",
  "description": "Lattice Agent 契约层：源接口、事件、传输消息格式。根出口运行时零依赖（纯类型 + 共享纯函数），/schemas 子出口承载 zod 运行时校验",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}