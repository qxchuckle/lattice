{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@qcqx/lattice-web-ui": ["../web-ui/src/ui.ts"],
      "@qcqx/lattice-web-ui/boot": ["../web-ui/src/main.tsx"],
      "@qcqx/lattice-core": ["../core/src/index.ts"],
      "@qcqx/lattice-core/*": ["../core/src/*"],
      "@qcqx/lattice-services": ["../services/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../web-ui/src/types"],
  "exclude": ["dist", "node_modules"]
}
