{
  // refs 层构建配置：仅 tsc -b 类型检查用，运行产物构建仍走 vite+tsup（读 tsconfig.json）
  // 直接依赖：core / agent / agent-protocol（与 depcruise 分层一致）；
  // agent 的 d.ts 会带出 pipeline/source 类型，故需列出传递引用
  "extends": ["./tsconfig.json", "../../tsconfig.refs.base.json"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-types"
  },
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../agent/tsconfig.build.json"
    },
    {
      "path": "../agent-protocol/tsconfig.build.json"
    },
    {
      "path": "../agent-source/tsconfig.build.json"
    },
    {
      "path": "../agent-source-builtins/tsconfig.build.json"
    },
    {
      "path": "../agent-pipeline/tsconfig.build.json"
    }
  ]
}
