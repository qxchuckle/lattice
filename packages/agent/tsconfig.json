{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@qcqx/lattice-agent-pipeline": ["../agent-pipeline/src/index.ts"],
      "@qcqx/lattice-agent-protocol": [
        "../agent-protocol/src/index.ts"
      ],
      "@qcqx/lattice-agent-protocol/*": [
        "../agent-protocol/src/*"
      ],
      "@qcqx/lattice-agent-source": [
        "../agent-source/src/index.ts"
      ],
      "@qcqx/lattice-agent-source/*": [
        "../agent-source/src/*"
      ],
      "@qcqx/lattice-core": [
        "../core/src/index.ts"
      ],
      "@qcqx/lattice-core/*": [
        "../core/src/*"
      ]
    }
  },
  "include": [
    "src",
    "../../types"
  ]
}