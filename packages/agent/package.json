{
  "name": "@qcqx/lattice-agent",
  "version": "0.1.0",
  "description": "Lattice Agent 核心（平台无关）：对话树、工具注册、上下文引擎、工作流",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@qcqx/lattice-agent-protocol": "workspace:*",
    "@qcqx/lattice-agent-source": "workspace:*",
    "@qcqx/lattice-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}