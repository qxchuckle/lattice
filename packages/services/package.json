{
  "name": "@qcqx/lattice-services",
  "version": "0.1.0",
  "description": "Lattice 应用服务层：跨宿主共用的用例实现（web server / VSCode 扩展 / 未来客户端）",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@qcqx/lattice-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist"
  ]
}
