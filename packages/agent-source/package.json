{
  "name": "@qcqx/lattice-agent-source",
  "version": "0.1.0",
  "description": "Lattice Agent 源抽象层：标准化 AI 源交互接口，内置 Pi / Qoder 兼容",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist dist-types tsconfig.tsbuildinfo"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@qcqx/lattice-agent-protocol": "workspace:*",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^0.80.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}