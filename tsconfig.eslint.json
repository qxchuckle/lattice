{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@webview-protocol": ["./packages/vscode/webview/src/protocol.ts"],
      "@lattice-web-ui": ["./packages/web/src/client/ui.ts"],
      "@qcqx/lattice-core": ["./packages/core/src/index.ts"],
      "@qcqx/lattice-core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["**/*", "**/.*.*"],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "**/out",
    "**/test",
    "**/coverage",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    ".cursor/**",
    ".claude/**",
    ".pnpm-store/**",
    ".temp/**",
    ".temp-docs/**",
    ".tmp-home-ragtest/**",
    ".tmp-projects-ragtest/**",
    "**/.vscode-test/**",
    "coverage/**",
    "packages/vscode/media/**",
    "packages/vscode/dist/**",
    "packages/vscode/dist-vsix/**"
  ]
}
