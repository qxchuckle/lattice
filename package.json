{
  "name": "@qcqx/lattice-monorepo",
  "private": true,
  "description": "Lattice — 跨项目 AI 上下文管理工具",
  "license": "MIT",
  "author": {
    "name": "qcqx",
    "url": "https://github.com/qxchuckle"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qxchuckle/lattice.git"
  },
  "homepage": "https://github.com/qxchuckle/lattice#readme",
  "bugs": {
    "url": "https://github.com/qxchuckle/lattice/issues"
  },
  "keywords": [
    "lattice",
    "ai",
    "context",
    "cross-project",
    "monorepo"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch",
      "esbuild",
      "better-sqlite3",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node packages/web/ensure-node-pty.mjs",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @qcqx/lattice-core run build",
    "build:cli": "pnpm --filter @qcqx/lattice-cli run build",
    "build:web": "pnpm --filter @qcqx/lattice-web run build",
    "dev:core": "pnpm --filter @qcqx/lattice-core run dev",
    "dev:web": "pnpm --filter @qcqx/lattice-web run dev",
    "publish:core": "pnpm --filter @qcqx/lattice-core publish --no-git-checks",
    "publish:cli": "pnpm --filter @qcqx/lattice-cli publish --no-git-checks",
    "publish:web": "pnpm --filter @qcqx/lattice-web publish --no-git-checks",
    "release": "node scripts/release.mjs",
    "lint": "eslint . && pnpm run depcruise",
    "lint:fix": "eslint . --fix",
    "depcruise": "depcruise packages/agent-protocol/src packages/agent-source/src packages/agent-pipeline/src packages/agent/src packages/web/src packages/cli/src packages/core/src --config scripts/dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "typecheck": "tsc -b tsconfig.build.json",
    "typecheck:clean": "tsc -b tsconfig.build.json --clean",
    "check-types": "pnpm -r run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:report": "open coverage/index.html",
    "e2e": "pnpm --filter @qcqx/lattice-e2e exec playwright test",
    "rag:benchmark": "node scripts/rag-benchmark.mjs",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@archoleat/prettier-define-config": "^1.2.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.10"
  }
}