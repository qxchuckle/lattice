{
  "name": "@qcqx/lattice-monorepo",
  "private": true,
  "description": "Lattice — 本地优先的研发记忆与工作流层",
  "license": "MIT",
  "author": {
    "name": "qcqx",
    "url": "https://github.com/qxchuckle"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qxchuckle/lattice.git"
  },
  "homepage": "https://lattice.qcqx.cn/",
  "bugs": {
    "url": "https://github.com/qxchuckle/lattice/issues"
  },
  "keywords": [
    "lattice",
    "ai",
    "engineering-memory",
    "memory",
    "workflow",
    "knowledge-base",
    "ai-agent",
    "context",
    "cross-project",
    "monorepo"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch",
      "esbuild",
      "better-sqlite3",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "scripts": {
    "postinstall": "node packages/web/ensure-node-pty.mjs",
    "build": "pnpm --filter './packages/**' run build",
    "build:core": "pnpm --filter @qcqx/lattice-core run build",
    "build:services": "pnpm --filter @qcqx/lattice-services run build",
    "build:cli": "pnpm --filter @qcqx/lattice-cli run build",
    "build:web": "pnpm --filter @qcqx/lattice-web run build",
    "build:site": "pnpm --filter @qcqx/lattice-site run build",
    "sync:docs": "pnpm --filter @qcqx/lattice-site run sync:docs",
    "check:docs": "pnpm --filter @qcqx/lattice-site run check:docs",
    "selftest:site-gates": "pnpm --filter @qcqx/lattice-site run selftest:gates",
    "check:site": "pnpm --filter @qcqx/lattice-site run check",
    "build:vscode": "pnpm --filter lattice-context run build",
    "package:vscode": "pnpm build:vscode && pnpm --filter lattice-context run package",
    "verify:vscode": "pnpm lint && pnpm --filter lattice-context run check-types && vitest run --project vscode && pnpm build:vscode && pnpm --filter lattice-context run package",
    "dev:core": "pnpm --filter @qcqx/lattice-core run dev",
    "dev:web": "pnpm --filter @qcqx/lattice-web run dev",
    "dev:site": "pnpm --filter @qcqx/lattice-site run dev",
    "publish:core": "pnpm --filter @qcqx/lattice-core publish --no-git-checks",
    "publish:cli": "pnpm --filter @qcqx/lattice-cli publish --no-git-checks",
    "publish:web": "pnpm --filter @qcqx/lattice-web publish --no-git-checks",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "check-types": "pnpm -r run check-types",
    "check:cli-doc": "node packages/cli/scripts/check-projection-doc-sync.mjs --lang zh && node packages/cli/scripts/check-projection-doc-sync.mjs --lang en",
    "check:skill-i18n": "node packages/core/scripts/check-skill-i18n.mjs",
    "check:docs-i18n": "node scripts/check-docs-i18n.mjs",
    "rag:benchmark": "node scripts/rag-benchmark.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:core && pnpm build:cli && vitest run --project cli",
    "e2e": "pnpm build:core && pnpm build:services && pnpm build:web && pnpm --filter @qcqx/lattice-e2e run test",
    "e2e:headed": "pnpm --filter @qcqx/lattice-e2e run test:headed",
    "test:report": "open coverage/index.html",
    "ci:assert-tests": "node scripts/ci-assert-tests.mjs",
    "ci:smoke-cli": "node scripts/ci-cli-smoke.mjs",
    "clean": "pnpm -r run clean",
    "test:contract": "vitest run --project services --project web --project vscode",
    "publish:protocol": "pnpm --filter @qcqx/lattice-protocol publish --no-git-checks",
    "publish:services": "pnpm --filter @qcqx/lattice-services publish --no-git-checks",
    "publish:web-ui": "pnpm --filter @qcqx/lattice-web-ui publish --no-git-checks"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@archoleat/prettier-define-config": "^1.2.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.12"
  }
}
